{
  "name": "finance-sync",
  "version": "0.48.1",
  "private": true,
  "description": "Self-hosted finance ingestion, archive and export service for Unraid",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --experimental-sqlite dist/server.js",
    "dev": "tsx --experimental-sqlite src/server.ts",
    "newsletter:run": "node --experimental-sqlite dist/newsletter-worker.js",
    "test": "npm run build && node --experimental-sqlite --test dist/*.test.js dist/**/*.test.js && PYTHONPATH=python python3 -m unittest python/test_dkb_fints_helper.py",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@actual-app/api": "26.7.0",
    "agentmail": "^0.5.20",
    "busboy": "^1.6.0"
  },
  "overrides": {
    "adm-zip": "0.6.0"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/node": "22.15.3",
    "tsx": "4.20.6",
    "typescript": "5.8.3"
  }
}
