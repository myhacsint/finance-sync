<?xml version="1.0"?>
<Container version="2">
  <Name>Ghostfolio-Redis</Name>
  <Repository>redis:alpine</Repository>
  <Registry>https://hub.docker.com/_/redis</Registry>
  <Network>finance-hub</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://hub.docker.com/_/redis</Support>
  <Project>https://redis.io/</Project>
  <Overview>Entbehrlicher, nicht veröffentlichter Redis-Cache für Ghostfolio.</Overview>
  <Category>Other:</Category>
  <WebUI/>
  <TemplateURL/>
  <Icon>https://raw.githubusercontent.com/docker-library/docs/master/redis/logo.png</Icon>
  <ExtraParams>--restart=unless-stopped --health-cmd=&quot;redis-cli -a \&quot;$$(cat /run/secrets/redis-password)\&quot; ping&quot; --health-interval=10s --health-timeout=5s --health-retries=5</ExtraParams>
  <PostArgs>redis-server /usr/local/etc/redis/redis.conf</PostArgs>
  <CPUset/>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="Konfiguration" Target="/usr/local/etc/redis/redis.conf" Default="/mnt/user/appdata/finance-hub/secrets/redis.conf" Mode="ro" Description="Root-geschützte Redis-Konfiguration" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/finance-hub/secrets/redis.conf</Config>
  <Config Name="Passwortdatei" Target="/run/secrets/redis-password" Default="/mnt/user/appdata/finance-hub/secrets/ghostfolio-redis-password" Mode="ro" Description="Nur für Healthcheck" Type="Path" Display="advanced" Required="true" Mask="false">/mnt/user/appdata/finance-hub/secrets/ghostfolio-redis-password</Config>
  <TailscaleStateDir/>
</Container>
